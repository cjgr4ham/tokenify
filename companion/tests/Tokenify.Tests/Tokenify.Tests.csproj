<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Self-contained test runner (no test framework download needed). After a build:
      Tokenify.Tests.exe test [fixtures-folder]       runs every test
      Tokenify.Tests.exe scan [file-or-folder] [-v]   prints what the parser finds in replays
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Tokenify.Tests</AssemblyName>
    <RootNamespace>Tokenify.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tokenify.ReplayReader\Tokenify.ReplayReader.csproj" />
    <ProjectReference Include="..\..\src\Tokenify.Core\Tokenify.Core.csproj" />
    <ProjectReference Include="..\..\src\Tokenify.Overlay\Tokenify.Overlay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\fixtures\expected.json" Link="fixtures-expected.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\expected-current.json" Link="fixtures-expected-current.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\registry\chest-registry.json" Link="chest-registry.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
